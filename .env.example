# Google Gemini API Key for SolveX AI Conflict-Checking Engine
# Get your free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Environment Variables (Service-Role configuration for Serverless Functions)
# NOTE: In Vercel, these are already added automatically via the Supabase-Vercel integration.
# For local development, do NOT type them manually; run:
#   vercel env pull .env.local
# This will pull down SUPABASE_URL and SUPABASE_SECRET_KEY into your .env.local
SUPABASE_URL=your_supabase_project_url
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key
